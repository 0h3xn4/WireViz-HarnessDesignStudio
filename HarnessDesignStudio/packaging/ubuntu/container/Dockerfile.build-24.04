# Build environment for release packages: Ubuntu 24.04 (Python 3.12 comes from the archive).
# The release check runs the whole test suite with HARNESS_REQUIRE_BROWSER=1 and fails on skipped
# tests, so the image needs what those tests use: poppler (pdfinfo) and Chromium (playwright, same
# version as pyproject.toml). Build the image on a connected machine, then build packages from it:
#   docker build -f packaging/ubuntu/container/Dockerfile.build-24.04 -t harness-build:24.04 .
#   docker run --rm -v "$PWD":/src -w /src harness-build:24.04 ./packaging/ubuntu/container/build-in-container.sh
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv git ca-certificates dpkg-dev poppler-utils \
    libegl1 libgl1 libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libdbus-1-3 libxcb-cursor0 \
    libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
 && python3 -m venv /opt/pw-venv && /opt/pw-venv/bin/pip install --no-cache-dir playwright==1.63.0 \
 && /opt/pw-venv/bin/playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/*
